{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "loupe (debug build) on kernel32.dll",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/loupe.exe",
            "args": ["-a", "C:/Windows/System32/kernel32.dll"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build (debug)"
        },
        {
            "name": "loupe (debug build) on a file you pick",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/loupe.exe",
            "args": ["-a", "${input:target}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build (debug)"
        },
        {
            "name": "unit tests",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/test/test_loupe.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "target",
            "type": "promptString",
            "description": "Path to the executable to inspect",
            "default": "C:/Windows/System32/notepad.exe"
        }
    ]
}
